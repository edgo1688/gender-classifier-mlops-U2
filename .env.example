# Azure Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here
AZURE_STORAGE_ACCOUNT_NAME=samlopsicesiu2
AZURE_STORAGE_CONTAINER_NAME=models

# Model Configuration
MODEL_URL=https://samlopsicesiu2.blob.core.windows.net/models/gender_googlenet.onnx
MODEL_PATH=./model/gender_googlenet.onnx

# Environment (dev or prod)
ENVIRONMENT=dev

# Test Data Configuration
TEST_DATA_CONTAINER=testdata
TEST_DATA_BLOB=test_samples.npz  # NPZ format for image test data

# Predictions Log Configuration
PREDICTIONS_CONTAINER=predictions
